#11547=PRODUCT('2026-11-12-23-11-56-310','(\X2\672A4FDD5B58\X0\)',$,(#11546));
#11548=PRODUCT('2026-11-12-23-11-56-632','01 Chassis - dry wet divider',

'Prototype polymer carrier; all liquid must remain inside sealed cartr
idge.',(#11546));
#11549=PRODUCT('2026-11-12-23-11-58-549','02 Removable cloud cage',
'Diffuser support; dress with removable translucent cover, keep unders
ide mist port clear.',(#11546));
#11550=PRODUCT('2026-11-12-23-12-04-792','03 LED saddle left',
'12 mm wide LED carrier; verify actual strip width and cut-group lengt
h.',(#11546));
#11551=PRODUCT('2026-11-12-23-12-06-949','04 LED saddle right',
'Two 50 mm mounting zones. Final LED cut groups pending measurement.',(#11546));
#11552=PRODUCT('2026-11-12-23-12-09-169',
'05 Reservoir cartridge - 10 mL target',
'36 x 22 x 22 mm, cavity 33 x 19 x 19 mm = 11.91 mL gross. NOT a valid
ated sealed tank.',(#11546));
#11553=PRODUCT('2026-11-12-23-12-10-884','06 Tank lid with refill neck',

'Removable gasketed lid concept, gasket compression and fasteners to f
inalize after atomizer selection.',(#11546));
#11554=PRODUCT('2026-11-12-23-12-13-036',
'07 Refill plug - silicone concept',
'Friction plug; real sealing fit requires material testing.',(#11546));
#11555=PRODUCT('2026-11-12-23-12-14-654','08 Lid gasket - placeholder',
'0.3 mm clearance shown. Specify actual seal before wet use.',(#11546));
#11556=PRODUCT('2026-11-12-23-12-15-616',
'09 Mist head mount - placeholder',
'Assumed 16 mm disc envelope; replace with selected matched atomizer a
nd driver.',(#11546));
#11557=PRODUCT('2026-11-12-23-12-17-443',
'10 Atomizer envelope - NOT selected',
'Dummy 16 x 2 mm envelope, no claim of actual compatibility.',(#11546));
#11558=PRODUCT('2026-11-12-23-12-18-266',
'11 ESP32 CAM envelope - measure first',
'40 x 27 x 10 mm simplified envelope. Connector/pin clearance not vali
dated.',(#11546));
#11559=PRODUCT('2026-11-12-23-12-19-807',
'12 Electronics removable tray',
'Upright camera cradle. Lens faces toward negative Y; soft-cover viewi
ng aperture and connector fit require hardware measurement.',(#11546));
#11560=PRODUCT('2026-11-12-23-12-23-723',
'13 Soil stake left - stainless 3 mm',
'145 mm straight structural rod; lower 55 mm in soil. No strength or p
ull-out validation.',(#11546));
#11561=PRODUCT('2026-11-12-23-12-24-632',
'13 Soil stake right - stainless 3 mm',
'145 mm straight structural rod; lower 55 mm in soil. No strength or p
ull-out validation.',(#11546));
#11562=PRODUCT('2026-11-12-23-12-25-604',
'14 Silver decorative branches',
'Shapeable wire ornament; structural loads carried by two straight rod
s. Bend templates only.',(#11546));
#11563=PRODUCT('2026-11-12-23-12-33-934',
'15 Rear power cable route - reference',
'Route low-voltage supply externally along rear stake. Supply and driv
er not designed here.',(#11546));
#11564=PRODUCT('2026-11-12-23-12-38-828',
'91 Flowerpot reference - 120 mm OD',
'Reference only; user has no selected pot. Rim z=10, soil z=0, base z=
-100.',(#11546));
#11565=PRODUCT('2026-11-12-23-15-20-011','16 Tank retaining bridge L',
'Removable concept hold-down. Fit and compression need prototype testi
ng; not a verified watertight closure.',(#11546));
#11566=PRODUCT('2026-11-12-23-15-23-133','16 Tank retaining bridge R',
'Removable concept hold-down. Fit and compression need prototype testi
ng; not a verified watertight closure.',(#11546));
